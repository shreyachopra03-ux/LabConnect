{
  "name": "company-a-report-delivery",
  "version": "0.1.0",
  "private": true,
  "description": "Secure lab report delivery: LIS import, expiring links, OTP patient portal, plain-language summaries, front-desk console.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "prisma db push --force-reset --skip-generate && prisma generate && prisma db seed",
    "lis:drop-sample": "node scripts/drop-sample.mjs signed",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lis:drop-amendment": "node scripts/drop-sample.mjs amended"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "5.22.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
